# ── Database ──
# Postgres (Neon free tier works well: 0.5 GB, no card, sleeps when idle).
# On Neon use the "pooled" connection string and append ?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional sync driver URL; only used if you run sync scripts.
DATABASE_URL_SYNC=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Connection pool. Keep small on free/serverless Postgres (Neon caps connections).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── JWT ──
# Must be a FIXED value or every restart invalidates all sessions.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── OpenAI (transcription, translation, TTS) ──
# Required on hosts without the local ML models installed.
OPENAI_API_KEY=sk-your-key-here

# ── NLLB Model (offline translation fallback; unused without transformers) ──
NLLB_MODEL=facebook/nllb-200-distilled-600M

# ── CORS ──
# Comma-separated allowed browser origins. Add your deployed frontend URL
# (e.g. https://your-app.vercel.app) or the API will reject all browser requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres (asyncpg). Local Docker:
#   DATABASE_URL=postgresql+asyncpg://postgres:pw@localhost:5433/bami_soro
# Neon (use the "pooled" connection string; asyncpg requires SSL by default,
# do NOT add ?sslmode=require):
#   DATABASE_URL=postgresql+asyncpg://USER:PW@ep-xxx-pooler.REGION.aws.neon.tech/neondb
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bami_soro
DATABASE_URL_SYNC=postgresql+psycopg://postgres:password@localhost:5432/bami_soro?sslmode=require

# Keep small on free/serverless Postgres (Neon caps concurrent connections).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Must be a FIXED random value or every restart invalidates all sessions.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Required on hosts without the local ML models installed.
OPENAI_API_KEY=

NLLB_MODEL=facebook/nllb-200-distilled-600M

# Comma-separated allowed browser origins. Add your deployed frontend URL
# (e.g. https://your-app.vercel.app) or the API will reject all browser requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
